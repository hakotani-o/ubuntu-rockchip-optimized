&pwm1 {
	pinctrl-0 = <&pwm1m0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&{/} {
	fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm1 0 50000 0>;
		cooling-levels = <0 32 64 96 128 160 192 224 255>;
		#cooling-cells = <2>;
	};
};

// 将风扇绑定到 SoC 温度传感器，自动调速
&soc_thermal {
	trips {
		soc_fan_trip0: fan-trip0 {
			temperature = <45000>;		// 45°C — 起转
			hysteresis = <5000>;
			type = "active";
		};
		soc_fan_trip1: fan-trip1 {
			temperature = <55000>;		// 55°C — 中速
			hysteresis = <5000>;
			type = "active";
		};
		soc_fan_trip2: fan-trip2 {
			temperature = <65000>;		// 65°C — 高速
			hysteresis = <5000>;
			type = "active";
		};
		soc_fan_trip3: fan-trip3 {
			temperature = <75000>;		// 75°C — 全速
			hysteresis = <5000>;
			type = "active";
		};
	};

	cooling-maps {
		map0 {
			trip = <&soc_fan_trip0>;
			cooling-device = <&fan 0 2>;	// cooling-level 0~2 (0~96)
		};
		map1 {
			trip = <&soc_fan_trip1>;
			cooling-device = <&fan 2 4>;	// cooling-level 2~4 (96~160)
		};
		map2 {
			trip = <&soc_fan_trip2>;
			cooling-device = <&fan 4 6>;	// cooling-level 4~6 (160~224)
		};
		map3 {
			trip = <&soc_fan_trip3>;
			cooling-device = <&fan 6 8>;	// cooling-level 6~8 (224~255)
		};
	};
};
